{
  "extends": "./tooling/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@hana/plugin-protocol": [
        "packages/plugin-protocol/src/index.ts"
      ],
      "@hana/plugin-sdk": [
        "packages/plugin-sdk/src/index.ts"
      ],
      "@hana/plugin-runtime": [
        "packages/plugin-runtime/src/index.ts"
      ],
      "@hana/plugin-components": [
        "packages/plugin-components/src/index.ts"
      ],
      "@/*": [
        "apps/desktop/src/react/*"
      ]
    }
  },
  "include": [
    "apps/desktop/src/**/*.ts",
    "apps/desktop/src/**/*.tsx",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "apps/desktop/dist-renderer"
  ]
}
